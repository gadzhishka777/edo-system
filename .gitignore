# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
# Окружения при обновлении: venv-061 (новое), venv-old (старое после переключения)
venv-*/
env/
*.egg-info/
dist/
build/

# Бэкапы, которые делают deploy/backup.sh и deploy/upgrade.sh
backups/
# Копии, которые deploy/upgrade.sh --rollback оставляет перед перезаписью
*.before-rollback

# Базы данных
*.db
*.sqlite3

# Файлы окружения
.env
.env.local
.env.production

# Docker volumes
edo.db

# Загруженные файлы
uploads/
signed/
signed_docs/
archives/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Node
node_modules/
npm-debug.log*

# React build
frontend/build/

# Воркер pdf.js копируется в public/ скриптом frontend/scripts/copy-pdf-worker.js
# (хуки prestart/prebuild) — в репозитории ему делать нечего, версия должна
# всегда совпадать с react-pdf-овским pdfjs-dist.
frontend/public/pdf.worker.min.js

# Логи
*.log
logs/

# OS
.DS_Store
Thumbs.db
# SQLite WAL sidecar files
*.db-shm
*.db-wal

# Скриншоты для сверки с макетами (локальный артефакт, не для репозитория)
.screens/

# Локальные артефакты ИИ-ассистента и отладочных прогонов.
# В .tmp_test/ лежат cookie-jar с живыми JWT — в репозиторий попадать не должны.
.tmp_test/
.zcode/
