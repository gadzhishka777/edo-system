# ============================================================
# systemd-юнит для бэкенда ТОР ЭДО.
#
# ЗАЧЕМ: запускать `./deploy/start_backend.sh` в терминале на проде — плохо:
# процесс умрёт при обрыве SSH, не поднимется после перезагрузки сервера и не
# попадёт в журнал. Юнит решает всё это и не дублирует логику — он вызывает
# тот же скрипт, который сам находит venv, порт и выставляет переменные окружения.
#
# УСТАНОВКА:
#     chmod +x /opt/edo/deploy/start_backend.sh /opt/edo/deploy/wait_for_backend.sh
#     sudo cp /opt/edo/deploy/edo.service /etc/systemd/system/edo.service
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now edo
#     systemctl status edo
#
# ПРИМЕЧАНИЕ ПРО ЗАПУСК: скрипты вызываются явно через /bin/bash, а не как
# `./start_backend.sh`. Так юнит не зависит от бита исполняемости (его легко
# потерять при копировании через scp/rsync без -p или при редактировании
# файла чужим редактором) и от shebang. На работу это не влияет никак.
#
# ЕСЛИ СЕЙЧАС БЭКЕНД ЗАПУЩЕН ВРУЧНУЮ (tmux/screen/nohup) — сначала остановите
# его, иначе будет конфликт за порт 8005:
#     pkill -f "uvicorn app.main:app"
#     ss -ltnp | grep ':8005'          # должно быть пусто
#
# ПРОВЕРКА И УПРАВЛЕНИЕ:
#     journalctl -u edo -f             # логи в реальном времени
#     systemctl restart edo            # перезапуск (после обновления кода)
#     systemctl stop edo               # остановка
#
# ВАЖНО: юнит НЕ перезапускается автоматически при изменении кода. После
# `git pull` + переключения venv нужно `sudo systemctl restart edo`.
# ============================================================

[Unit]
Description=ТОР ЭДО — backend (FastAPI/uvicorn)
Documentation=file:/opt/edo/deploy/UPGRADE-0.6.1-COMMANDS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/edo

# Скрипт сам находит venv (backend/venv или <корень>/venv), ставит переменные
# окружения (APP_TIMEZONE, DOCS_ENABLED, UTF-8) и запускает uvicorn на 8005.
ExecStart=/bin/bash /opt/edo/deploy/start_backend.sh

# Переопределения без правки скрипта — раскомментируйте при необходимости:
# Environment=BACKEND_PORT=8005
# Environment=VENV_DIR=/opt/edo/venv
# Environment=LOG_LEVEL=INFO
Environment=PYTHONUNBUFFERED=1

# Готовность: ждём ответа /api/health (отдельный скрипт, чтобы не бороться
# с раскрытием `$` в юните). Если приложение не поднялось за 30 с, юнит
# помечается как failed — это сразу видно в `systemctl status edo`,
# а не молчаливое «запущено, но не работает».
# Уберите строку, если проверка не нужна.
ExecStartPost=/bin/bash /opt/edo/deploy/wait_for_backend.sh

# Автоподъём после падения и после перезагрузки сервера.
Restart=always
RestartSec=3

# При остановке гасим всю группу процессов (uvicorn + 2 воркера),
# иначе воркеры останутся держать порт.
KillMode=mixed
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=edo

# --- Пользователь ---
# По умолчанию сервис работает от root — как и ручной запуск через sudo.
# Чтобы понизить права, раскомментируйте User/Group И заранее отдайте владение
# данным (SQLite, uploads, signed_docs, штампы — бэкенд в них пишет):
#     sudo useradd --system --no-create-home edo
#     sudo chown -R edo:edo /opt/edo/backend /opt/edo/frontend/public/stamps
# User=edo
# Group=edo

[Install]
WantedBy=multi-user.target
