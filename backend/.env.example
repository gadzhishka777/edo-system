# ===== Backend .env.example =====
# Скопируйте в .env и заполните своими значениями

# Секретный ключ JWT — ОБЯЗАТЕЛЬНО заменить!
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_RANDOM_HEX_STRING

# Учётные данные администратора
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ===== Режим работы =====
# Интерактивная документация /docs, /redoc, /openapi.json.
# В продакшене ОБЯЗАТЕЛЬНО false — Swagger раскрывает всю схему API.
DOCS_ENABLED=false
# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ===== Время =====
# Часовой пояс приложения (app/core/time.py). Все времена в БД и API —
# московские. Сервер тоже должен жить в этой зоне:
#     sudo timedatectl set-timezone Europe/Moscow
APP_TIMEZONE=Europe/Moscow

# CORS: список разрешённых origins (JSON-массив или строка через запятую).
# В проде — только реальный домен, localhost убрать.
# Сайт и API на одном домене, поэтому CORS в норме не нужен вовсе:
# оставьте только свой origin как страховку.
CORS_ORIGINS=https://toredo.mroo-snpm.ru

# ===== SSRF-защита штампов ЭП =====
# Белый список хостов, с которых разрешено скачивать картинку штампа
# по URL (POST /api/documents/visualize, поле stamp_url).
# Пусто = разрешены любые ПУБЛИЧНЫЕ http(s)-адреса; приватные IP
# (127.0.0.1, 10.x, 192.168.x, 169.254.169.254 и т.п.) блокируются всегда.
# Рекомендуется для прода: перечислить только свой домен.
STAMP_URL_ALLOWED_HOSTS=toredo.mroo-snpm.ru

# Go GOST — сервис проверки ЭП
# В docker-compose: http://gost:8080
# Локально: http://localhost:8080
GOST_API_URL=http://gost:8080
GOST_API_KEY=
GOST_TIMEOUT=30

# ===== SMTP для писем по обращениям =====
# Если пусто — письма не отправляются, ответ сохраняется в карточке обращения.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Подсистема обмена. ТОР ЭДО
SMTP_USE_TLS=true

# ===== ЕИС «Образовательный портал» (ESA) =====
# Включить/выключить вход через ЕИС.
ESA_ENABLED=true
# Публичный идентификатор сервиса (выдаётся администратором ЕСА при регистрации).
ESA_APP_ID=toredo
# Секрет сервиса — ТОЛЬКО серверная переменная, не публиковать и не коммитить.
ESA_APP_SECRET=CHANGE_ME_TO_ESA_APP_SECRET
# Адреса ESA (по умолчанию — прод МРОО СНПМ).
ESA_AUTHORIZE_URL=https://esa.mroo-snpm.ru/oauth/authorize
ESA_TOKEN_URL=https://api.mroo-snpm.ru/oauth/token
ESA_USERINFO_URL=https://api.mroo-snpm.ru/auth/userinfo
# Должен ТОЧНО совпадать с зарегистрированным в ESA callback.
ESA_REDIRECT_URI=https://toredo.mroo-snpm.ru/api/auth/eis/callback
# Скоупы (через запятую или JSON-массив). Строго те, что согласованы при регистрации.
ESA_SCOPES=scopes.viewFullName,scopes.viewEmail,scopes.viewPhone,scopes.viewBirthday,scopes.viewVkID,scopes.viewMaxID,scopes.viewTeamHistory
# HMAC-секрет для подписи state. Если пусто — используется SECRET_KEY.
# Для прода рекомендуется задать отдельный.
ESA_STATE_SECRET=
# TTL подписанного state (сек). По умолчанию 5 минут.
ESA_STATE_TTL_SECONDS=300
# TTL одноразового кода обмена (callback → SPA). По умолчанию 60 секунд.
ESA_EXCHANGE_CODE_TTL_SECONDS=60
# Детальное логирование ESA-flow (callback/exchange). true — логировать шаги,
# false — отключить. Включайте временно при отладке входа через ЕИС.
ESA_DEBUG=false
# Базовый URL фронтенда для редиректов (пустая строка = тот же origin).
FRONTEND_BASE_URL=
