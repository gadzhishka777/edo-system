# ===== Backend .env.example =====
# Скопируйте в .env и заполните своими значениями

# Секретный ключ JWT — ОБЯЗАТЕЛЬНО заменить!
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_RANDOM_HEX_STRING

# Учётные данные администратора
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# CORS: список разрешённых origins (JSON-массив)
CORS_ORIGINS=["https://edo.ped-id.ru"]

# Go GOST — сервис проверки ЭП
# В docker-compose: http://gost:8080
# Локально: http://localhost:8080
GOST_API_URL=http://gost:8080
GOST_API_KEY=
GOST_TIMEOUT=30
